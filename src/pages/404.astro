---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="404 | Page Not Found"
    description="The requested page could not be found."
>
    <section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
        <h1 class="text-8xl font-bold text-gray-900">
            404
        </h1>

        <h2 class="mt-4 text-2xl font-semibold">
            Page Not Found
        </h2>

        <p class="mt-3 max-w-md text-gray-600">
            The page you're looking for doesn't exist
            or may have been moved.
        </p>

        <a
            href="/"
            class="mt-6 rounded-lg bg-blue-600 px-6 py-3 text-white transition-colors hover:bg-blue-700"
        >
            Return to Homepage
        </a>
    </section>
</BaseLayout>