
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact | Engineering Journal"
    description="Get in touch about engineering, projects and technical discussions."
>
    <div class="mx-auto max-w-3xl space-y-8">

        <!-- Page Introduction -->
        <section>
            <h1 class="text-4xl font-bold">
                Get in Touch
            </h1>

            <p class="mt-4 leading-relaxed text-gray-600">
                Have a question, technical discussion,
                collaboration idea or feedback?
                Feel free to connect.
            </p>
        </section>

        <!-- Contact Information -->
        <section>
            <h2 class="text-2xl font-semibold">
                Connect With Me
            </h2>

            <div class="mt-5 space-y-4">

                <!-- Email -->
                <div>
                    <h3 class="font-medium">Email</h3>

                    <a
                        href="mailto:apexfury123@gmail.com"
                        class="text-blue-600 hover:underline"
                    >
                        apexfury123@gmail.com
                    </a>
                </div>

                <!-- GitHub -->
                <div>
                    <h3 class="font-medium">GitHub</h3>

                    <a
                        href="https://github.com/CruelFury15"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-600 hover:underline"
                    >
                        CruelFury15
                    </a>
                </div>

                <!-- LinkedIn -->
                <div>
                    <h3 class="font-medium">LinkedIn</h3>

                    <a
                        href="https://www.linkedin.com/in/apex-fury-150805ys/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-600 hover:underline"
                    >
                        Yuvraj Singh
                    </a>
                </div>

            </div>
        </section>

    </div>
</BaseLayout>
