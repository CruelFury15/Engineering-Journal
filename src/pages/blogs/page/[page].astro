
---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentCard from "../../../components/ContentCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const POSTS_PER_PAGE = 6;

    const posts = await getCollection(
        "blog",
        ({ data }) => !data.draft && !data.featured
    );

    posts.sort(
        (a, b) =>
            b.data.pubDate.getTime() - a.data.pubDate.getTime()
    );

    const totalPages = Math.ceil(
        posts.length / POSTS_PER_PAGE
    );

    return Array.from(
        { length: Math.max(0, totalPages - 1) },
        (_, index) => {
            const pageNumber = index + 2;
            const startIndex = (pageNumber - 1) * POSTS_PER_PAGE;

            return {
                params: {
                    page: String(pageNumber)
                },
                props: {
                    posts: posts.slice(
                        startIndex,
                        startIndex + POSTS_PER_PAGE
                    ),
                    currentPage: pageNumber,
                    totalPages
                }
            };
        }
    );
}

const { posts, currentPage, totalPages } = Astro.props;

const pageNumbers = Array.from(
    { length: totalPages },
    (_, index) => index + 1
);
---

<BaseLayout
    title={`Articles - Page ${currentPage} | Engineering Journal`}
    description={`Browse technical articles, page ${currentPage}.`}
>
    <section>
        <h1 class="text-4xl font-bold">
            All Articles
        </h1>

        <p class="mt-2 text-gray-600">
            Page {currentPage} of {totalPages}
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
                <ContentCard
                    title={post.data.title}
                    description={post.data.description}
                    href={`/blogs/${post.id}`}
                    meta={post.data.pubDate.toDateString()}
                />
            ))}
        </div>
    </section>

    <nav
        aria-label="Article pagination"
        class="mt-12 flex flex-wrap items-center justify-center gap-2"
    >
        <a
            href={currentPage === 2
                ? "/blogs"
                : `/blogs/page/${currentPage - 1}`}
            class="rounded-lg border border-gray-200 px-4 py-2 text-sm hover:bg-gray-100"
        >
            ← Previous
        </a>

        {pageNumbers.map((page) => (
            <a
                href={page === 1 ? "/blogs" : `/blogs/page/${page}`}
                aria-current={page === currentPage ? "page" : undefined}
                class:list={[
                    "rounded-lg border px-4 py-2 text-sm",
                    page === currentPage
                        ? "border-blue-600 bg-blue-600 text-white"
                        : "border-gray-200 hover:bg-gray-100"
                ]}
            >
                {page}
            </a>
        ))}

        {
            currentPage < totalPages && (
                <a
                    href={`/blogs/page/${currentPage + 1}`}
                    class="rounded-lg border border-gray-200 px-4 py-2 text-sm hover:bg-gray-100"
                >
                    Next →
                </a>
            )
        }
    </nav>
</BaseLayout>
