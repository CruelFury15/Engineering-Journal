---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection, render } from "astro:content";

// ==========================================
// 1. Generate Static Blog Routes
// ==========================================

export async function getStaticPaths() {
    const posts = await getCollection(
        "blog",
        ({ data }) => !data.draft
    );

    return posts.map((post) => ({
        params: {
            slug: post.id
        },
        props: {
            post
        }
    }));
}

const { post } = Astro.props;

// ==========================================
// 2. Related Articles Recommendation Engine
// ==========================================

// Fetch all published articles
const allPosts = await getCollection(
    "blog",
    ({ data }) => !data.draft
);

// Use Astro's inferred collection-entry type
type BlogPost = (typeof allPosts)[number];

// Normalize metadata
const normalize = (value: string): string =>
    value.trim().toLowerCase();

// Extract unique topics
const getTopics = (entry: BlogPost): string[] =>
  [
    ...new Set(
      (entry.data.topics ?? []).map((topic) =>
        normalize(typeof topic === "string" ? topic : topic.id)
      )
    ),
  ];

// Extract unique tags
const getTags = (entry: BlogPost): string[] =>
    [
        ...new Set(
            (entry.data.tags ?? []).map(normalize)
        )
    ];

// Build metadata frequency maps
const topicFrequency = new Map<string, number>();
const tagFrequency = new Map<string, number>();

for (const entry of allPosts) {

    for (const topic of getTopics(entry)) {
        topicFrequency.set(
            topic,
            (topicFrequency.get(topic) ?? 0) + 1
        );
    }

    for (const tag of getTags(entry)) {
        tagFrequency.set(
            tag,
            (tagFrequency.get(tag) ?? 0) + 1
        );
    }
}

// Inverse square-root frequency weighting
const getMetadataWeight = (
    value: string,
    frequencyMap: Map<string, number>
): number => {

    const frequency = frequencyMap.get(value) ?? 0;

    return frequency > 0
        ? 1 / Math.sqrt(frequency)
        : 0;
};

// Current article metadata
const currentTopics = new Set(getTopics(post));
const currentTags = new Set(getTags(post));

// Calculate recommendation scores
const relatedPosts = allPosts

    // Exclude current article
    .filter((candidate) => candidate.id !== post.id)

    .map((candidate) => {

        const candidateTopics = getTopics(candidate);
        const candidateTags = getTags(candidate);

        let score = 0;

        // Shared topics: base weight 3
        for (const topic of candidateTopics) {

            if (currentTopics.has(topic)) {
                score +=
                    3 * getMetadataWeight(
                        topic,
                        topicFrequency
                    );
            }
        }

        // Shared tags: base weight 2
        for (const tag of candidateTags) {

            if (currentTags.has(tag)) {
                score +=
                    2 * getMetadataWeight(
                        tag,
                        tagFrequency
                    );
            }
        }

        return {
            post: candidate,
            score
        };
    })

    // Remove articles without matching metadata
    .filter((item) => item.score > 0)

    // Rank recommendations
    .sort((a, b) => {

        // Highest relevance first
        const scoreDifference = b.score - a.score;

        if (Math.abs(scoreDifference) > 1e-9) {
            return scoreDifference;
        }

        // Newer publication date wins on equal scores
        const dateDifference =
            b.post.data.pubDate.getTime() -
            a.post.data.pubDate.getTime();

        if (dateDifference !== 0) {
            return dateDifference;
        }

        // Stable final tie-breaker
        return a.post.id.localeCompare(b.post.id);
    })

    // Maximum three recommendations
    .slice(0, 3)

    // Extract article entries
    .map((item) => item.post);


// ==========================================
// 3. Calculate Reading Time
// ==========================================

const content = post.body ?? "";

// Extract code blocks.
const codeBlocks = content.match(/```[\s\S]*?```/g) ?? [];

const codeText = codeBlocks.join(" ");

const codeWordCount = codeText
  .replace(/```[\w-]*/g, "")
  .replace(/```/g, "")
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;

// Remove code blocks before counting normal text.
const textContent = content.replace(/```[\s\S]*?```/g, "");

const textWordCount = textContent
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;

// Calculate weighted reading time.
const readingTime = Math.max(
  1,
  Math.ceil(textWordCount / 200 + codeWordCount / 50)
);


// ==========================================
// 4. Render Article and Extract Headings
// ==========================================

const { Content, headings } = await render(post);

// Generate Table of Contents
const tableOfContents = headings.filter(
    (heading) =>
        heading.depth === 2 ||
        heading.depth === 3
);

---

<BaseLayout
  title={`${post.data.title} | Engineering Journal`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
>
<script
    type="application/ld+json"
    set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.pubDate.toISOString(),
        dateModified: (
            post.data.updatedDate ?? post.data.pubDate
        ).toISOString(),
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": new URL(
                Astro.url.pathname,
                Astro.site ?? Astro.url.origin
            ).href,
        },
        publisher: {
            "@type": "Organization",
            name: "Engineering Journal",
        },
    }).replace(/</g, "\\u003c")}
/>
    <!-- ====================================== -->
    <!-- Reading Progress Bar                   -->
    <!-- ====================================== -->

    <div
        id="reading-progress"
        class="fixed left-0 top-0 z-50 h-1 w-0 bg-blue-600"
        role="progressbar"
        aria-label="Article reading progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
    ></div>


    <!-- ====================================== -->
    <!-- Back to Top Button                     -->
    <!-- ====================================== -->

    <button
        id="back-to-top"
        type="button"
        aria-label="Back to top"
        title="Back to top"
        class="fixed bottom-6 right-6 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 text-white opacity-0 invisible pointer-events-none shadow-lg transition-all duration-300 hover:bg-blue-700 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="m18 15-6-6-6 6" />
        </svg>
    </button>


    <!-- ====================================== -->
    <!-- Main Article                           -->
    <!-- ====================================== -->

    <article id="blog-article">

        <!-- Article Header -->
        <header class="mb-8">

            <h1 class="text-4xl font-bold">
                {post.data.title}
            </h1>

            <div class="mt-4 space-y-2 text-sm text-gray-500">

                <p>
                    Published: {post.data.pubDate.toDateString()}
                </p>

                {
                    post.data.updatedDate && (
                        <p>
                            Last updated:
                            {post.data.updatedDate.toDateString()}
                        </p>
                    )
                }

                <p>{readingTime} min read</p>

            </div>

            <!-- Article Tags -->
            {
                post.data.tags.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-3">
                        {post.data.tags.map((tag) => (
                            <span
                                class="rounded-full bg-blue-50 px-4 py-2 text-xs font-medium text-blue-500"
                            >
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }

        </header>


        <hr class="border-gray-200" />


        <!-- ================================== -->
        <!-- Table of Contents                  -->
        <!-- ================================== -->

        {
            tableOfContents.length > 0 && (
                <nav
                    aria-label="Table of contents"
                    class="my-8 rounded-xl border border-gray-200 p-5"
                >

                    <h2 class="mb-4 text-lg font-semibold">
                        Table of Contents
                    </h2>

                    <ul class="space-y-2">

                        {tableOfContents.map((heading) => (
                            <li
                                class={
                                    heading.depth === 3
                                        ? "ml-5"
                                        : ""
                                }
                            >
                                <a
                                    href={`#${heading.slug}`}
                                    class="text-sm text-blue-600 hover:underline"
                                >
                                    {heading.text}
                                </a>
                            </li>
                        ))}

                    </ul>

                </nav>
            )
        }


        <!-- ================================== -->
        <!-- Article Content                    -->
        <!-- ================================== -->

        <div
            class="prose prose-gray max-w-none prose-headings:font-semibold prose-a:text-blue-600"
        >
            <Content />
        </div>


        <!-- ================================== -->
        <!-- Back to Articles                    -->
        <!-- ================================== -->

        <div class="mt-12 border-t border-gray-200 pt-6">

            <a
                href="/blogs"
                class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 transition-colors hover:text-blue-800"
            >
                <span aria-hidden="true">←</span>
                Back to all articles
            </a>

        </div>

    </article>


    <!-- ====================================== -->
    <!-- Related Articles                       -->
    <!-- ====================================== -->

    {
        relatedPosts.length > 0 && (
            <section class="mt-16 border-t border-gray-200 pt-10">

                <div class="mb-6">

                    <h2 class="text-2xl font-bold">
                        Related Articles
                    </h2>

                    <p class="mt-2 text-sm text-gray-500">
                        Continue exploring related engineering topics.
                    </p>

                </div>

                <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">

                    {relatedPosts.map((relatedPost) => (
                        <ContentCard
                            title={relatedPost.data.title}
                            description={relatedPost.data.description}
                            href={`/blogs/${relatedPost.id}`}
                            meta={relatedPost.data.pubDate.toDateString()}
                        />
                    ))}

                </div>

            </section>
        )
    }


    <!-- ====================================== -->
    <!-- Client-Side Functionality              -->
    <!-- ====================================== -->

    <script>

        // ======================================
        // 1. Copy Code Functionality
        // ======================================

        document
            .querySelectorAll("article .prose pre")
            .forEach((pre) => {

                const code = pre.querySelector("code");

                if (
                    !code ||
                    pre.querySelector(".copy-code-button")
                ) {
                    return;
                }

                const button = document.createElement("button");

                button.type = "button";
                button.textContent = "Copy";

                button.className =
                    "copy-code-button absolute right-3 top-3 rounded bg-gray-700 px-3 py-1 text-xs text-white hover:bg-gray-600";

                pre.classList.add("relative");

                button.addEventListener("click", async () => {

                    try {

                        await navigator.clipboard.writeText(
                            code.textContent ?? ""
                        );

                        button.textContent = "Copied!";

                        setTimeout(() => {
                            button.textContent = "Copy";
                        }, 1500);

                    } catch (error) {

                        console.error("Copy failed:", error);

                        button.textContent = "Failed";
                    }

                });

                pre.appendChild(button);

            });


        // ======================================
        // 2. Reading Progress Bar
        // ======================================

        const progressBar =
            document.querySelector("#reading-progress");

        const article =
            document.querySelector("#blog-article");

        if (progressBar && article) {

            let ticking = false;

            const updateProgress = () => {

                const articleTop =
                    article.getBoundingClientRect().top +
                    window.scrollY;

                const articleHeight = article.offsetHeight;

                const viewportHeight = window.innerHeight;

                const scrollableDistance =
                    articleHeight - viewportHeight;

                let progress = 0;

                if (scrollableDistance > 0) {

                    const currentPosition =
                        window.scrollY - articleTop;

                    progress = Math.min(
                        100,
                        Math.max(
                            0,
                            (currentPosition / scrollableDistance) * 100
                        )
                    );

                } else {

                    progress =
                        window.scrollY + viewportHeight >=
                        articleTop + articleHeight
                            ? 100
                            : 0;
                }

                progressBar.style.width = `${progress}%`;

                progressBar.setAttribute(
                    "aria-valuenow",
                    String(Math.round(progress))
                );

                ticking = false;
            };

            const requestUpdate = () => {

                if (!ticking) {

                    window.requestAnimationFrame(updateProgress);

                    ticking = true;
                }
            };

            window.addEventListener(
                "scroll",
                requestUpdate,
                { passive: true }
            );

            window.addEventListener(
                "resize",
                requestUpdate
            );

            updateProgress();
        }


        // ======================================
        // 3. Back to Top Button
        // ======================================

        const backToTopButton =
            document.querySelector("#back-to-top");

        if (backToTopButton) {

            const toggleBackToTop = () => {

                const isVisible = window.scrollY > 400;

                if (isVisible) {

                    backToTopButton.classList.remove(
                        "opacity-0",
                        "invisible",
                        "pointer-events-none"
                    );

                    backToTopButton.classList.add(
                        "opacity-100",
                        "visible",
                        "pointer-events-auto"
                    );

                } else {

                    backToTopButton.classList.remove(
                        "opacity-100",
                        "visible",
                        "pointer-events-auto"
                    );

                    backToTopButton.classList.add(
                        "opacity-0",
                        "invisible",
                        "pointer-events-none"
                    );
                }
            };

            window.addEventListener(
                "scroll",
                toggleBackToTop,
                { passive: true }
            );

            backToTopButton.addEventListener("click", () => {

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            });

            toggleBackToTop();
        }

    </script>

</BaseLayout>