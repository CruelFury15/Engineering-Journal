
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Search | Engineering Journal"
    description="Search technical articles and engineering content."
>
    <section data-pagefind-ignore>
        <h1 class="text-4xl font-bold">
            Search Engineering Journal
        </h1>

        <p class="mt-3 text-gray-600">
            Find articles, projects and technical topics.
        </p>

        <!-- Search input and Clear button -->
        <div class="mt-8">
            <label
                for="search"
                class="mb-2 block text-sm font-medium"
            >
                Search content
            </label>

            <div class="flex gap-2">
                <input
                    id="search"
                    type="search"
                    placeholder="Search articles, technologies, topics..."
                    autocomplete="off"
                    class="min-w-0 flex-1 rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                />

                <button
                    id="clear-search"
                    type="button"
                    class="rounded-lg border border-gray-300 px-4 py-3 text-sm font-medium transition-colors hover:bg-gray-100"
                >
                    Clear
                </button>
            </div>
        </div>

        <!-- Search status -->
        <p
            id="search-status"
            class="mt-4 text-sm text-gray-500"
            aria-live="polite"
            role="status"
        ></p>

        <!-- Search results -->
        <div
            id="search-results"
            class="mt-8 grid gap-4"
        ></div>
    </section>

    <script is:inline type="module">
        const initializeSearch = async () => {
            // 1. Get DOM elements
            const searchInput = document.querySelector("#search");
            const resultsContainer =
                document.querySelector("#search-results");
            const status = document.querySelector("#search-status");
            const clearButton = document.querySelector("#clear-search");

            // 2. Validate elements
            if (
                !searchInput ||
                !resultsContainer ||
                !status ||
                !clearButton
            ) {
                console.error("Search elements not found.");
                return;
            }

            // 3. State
            let pagefind = null;
            let debounceTimer = null;
            let requestId = 0;

            // 4. Clear search function
            const clearSearch = () => {
                clearTimeout(debounceTimer);

                // Invalidate pending asynchronous searches
                requestId++;

                searchInput.value = "";
                resultsContainer.replaceChildren();
                status.textContent = "";
            };

            // 5. Clear button event
            clearButton.addEventListener("click", () => {
                clearSearch();
                searchInput.focus();
            });

            // 6. Escape key event
            searchInput.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    clearSearch();
                    searchInput.focus();
                }
            });

            // 7. Initialize Pagefind
            try {
                status.textContent = "Initializing search...";

                pagefind = await import("/pagefind/pagefind.js");

                await pagefind.init();

                status.textContent = "";

                console.log("Pagefind initialized successfully.");

            } catch (error) {
                console.error("Pagefind initialization failed:", error);

                status.textContent =
                    "Search is currently unavailable. Please try again later.";

                return;
            }

            // 8. Search input event
            searchInput.addEventListener("input", () => {
                clearTimeout(debounceTimer);

                // Invalidate older requests immediately
                requestId++;

                const query = searchInput.value.trim();

                resultsContainer.replaceChildren();

                // Minimum query length
                if (query.length < 2) {
                    status.textContent = query.length === 0
                        ? ""
                        : "Enter at least 2 characters.";

                    return;
                }

                status.textContent = "Waiting for input...";

                // 9. Debounced search
                debounceTimer = setTimeout(async () => {
                    const currentRequest = requestId;

                    status.textContent = "Searching...";

                    try {
                        const search = await pagefind.search(query);

                        const results = await Promise.all(
                            search.results.map(
                                (result) => result.data()
                            )
                        );

                        // Ignore outdated responses
                        if (currentRequest !== requestId) {
                            return;
                        }

                        // 10. No results
                        if (results.length === 0) {
                            status.textContent = "No results found.";
                            return;
                        }

                        status.textContent =
                            `${results.length} results found.`;

                        // 11. Render result cards
                        results.forEach((result) => {
                            const article =
                                document.createElement("article");

                            article.className =
                                "rounded-xl border border-gray-200 p-5 transition-shadow hover:shadow-md";

                            // Article title
                            const heading =
                                document.createElement("h2");

                            heading.className =
                                "text-lg font-semibold";

                            const link =
                                document.createElement("a");

                            link.href = result.url;

                            link.textContent =
                                result.meta?.title || "Untitled article";

                            link.className =
                                "text-blue-600 hover:underline";

                            heading.appendChild(link);

                            // Article excerpt
                            const description =
                                document.createElement("p");

                            description.className =
                                "mt-2 text-sm leading-relaxed text-gray-600";

                            const parsedExcerpt =
                                new DOMParser().parseFromString(
                                    result.excerpt || "",
                                    "text/html"
                                );

                            description.textContent =
                                parsedExcerpt.body.textContent?.trim() ||
                                "No excerpt available.";

                            // Article URL
                            const url =
                                document.createElement("p");

                            url.className =
                                "mt-3 text-xs text-gray-400";

                            url.textContent = result.url;

                            // Assemble card
                            article.append(
                                heading,
                                description,
                                url
                            );

                            resultsContainer.appendChild(article);
                        });

                    } catch (error) {
                        if (currentRequest !== requestId) {
                            return;
                        }

                        console.error("Search execution failed:", error);

                        status.textContent =
                            "Unable to perform search. Please try again.";
                    }
                }, 300);
            });
        };

        initializeSearch();
    </script>
</BaseLayout>
