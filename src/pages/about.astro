---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="About | Engineering Journal"
    description="About the author and the Engineering Journal publication."
>
    <div class="max-w-3xl space-y-10">

        <section>
            <h1 class="text-4xl font-bold">
                About Engineering Journal
            </h1>

            <p class="mt-4 text-gray-600 leading-relaxed">
                Engineering Journal is a personal engineering
                publication documenting software development,
                technical experiments, system architecture
                and lessons learned while building software.
            </p>
        </section>

        <section>
            <h2 class="text-2xl font-semibold">
                What You'll Find Here
            </h2>

            <ul class="mt-4 list-disc space-y-2 pl-6 text-gray-600">
                <li>Software engineering and system design.</li>
                <li>Backend development and distributed systems.</li>
                <li>Artificial Intelligence and Machine Learning.</li>
                <li>Real-time systems and data engineering.</li>
                <li>Practical project documentation and debugging.</li>
            </ul>
        </section>

        <section>
            <h2 class="text-2xl font-semibold">
                Engineering Philosophy
            </h2>

            <p class="mt-4 text-gray-600 leading-relaxed">
                Focus on understanding problems, designing
                maintainable systems, validating implementations
                and documenting engineering decisions.
            </p>
        </section>

        <section>
            <h2 class="text-2xl font-semibold">
                Current Focus
            </h2>

            <p class="mt-4 text-gray-600">
                Building practical software systems,
                exploring AI/ML and improving engineering
                and architectural skills.
            </p>
        </section>

    </div>
</BaseLayout>