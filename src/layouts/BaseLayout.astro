
---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
    ogType?: "website" | "article";
    publishedTime?: string;
    modifiedTime?: string;
}

const {
    title,
    description = "Engineering Journal — Think. Build. Debug. Document.",
    image,
    ogType = "website",
    publishedTime,
    modifiedTime
} = Astro.props;

// Canonical URL: excludes query parameters and fragments.
const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site ?? Astro.url.origin
);

// Default social image; individual pages can override it.
const socialImage = new URL(
    image ?? "/brand/og-default.png",
    Astro.site ?? Astro.url.origin
).href;

const socialImageAlt = "Engineering Journal — By ApexFury";
---

<html lang="en">
    <head>
        <!-- Basic Metadata -->
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta name="theme-color" content="#153D32" />

        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL.href} />

        <!-- RSS Autodiscovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Engineering Journal RSS Feed"
            href="/rss.xml"
        />

        <!-- Open Graph Metadata -->
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta
            property="og:site_name"
            content="Engineering Journal"
        />

        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={socialImageAlt} />

        {ogType === "article" && publishedTime && (
            <meta
                property="article:published_time"
                content={publishedTime}
            />
        )}

        {ogType === "article" && modifiedTime && (
            <meta
                property="article:modified_time"
                content={modifiedTime}
            />
        )}

        <!-- Twitter Card Metadata -->
        <meta
            name="twitter:card"
            content="summary_large_image"
        />

        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta
            name="twitter:image:alt"
            content={socialImageAlt}
        />
    </head>

    <body>
        <Navbar />
        <!-- Main Page Content -->
        <main
            data-pagefind-body
            class="mx-auto min-h-[80vh] max-w-7xl px-4 py-8 sm:px-6 sm:py-10"
        >
            <slot />
        </main>

        <Footer />
    </body>
</html>
