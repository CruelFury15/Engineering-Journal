
---
const currentYear = new Date().getFullYear();

const footerLinks = [
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" },
    { label: "Blogs", href: "/blogs" },
    { label: "Projects", href: "/projects" },
    { label: "RSS Feed", href: "/rss.xml" }
];
---

<footer class="mt-16 border-t border-gray-200">
    <div class="mx-auto max-w-7xl px-6 py-8">

        <div class="flex flex-col justify-between gap-5 sm:flex-row">

            <div class="flex items-start gap-3">
    <img
        src="/favicon.svg"
        alt=""
        width="40"
        height="40"
        class="h-10 w-10"
    />

    <div>
        <p class="font-serif text-lg font-semibold text-[#153D32]">
            Engineering Journal
        </p>

        <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.25em] text-[#8FA99A]">
            By ApexFury
        </p>

        <p class="mt-2 text-sm text-gray-500">
            Think. Build. Debug. Document.
        </p>
    </div>
</div>

            <!-- Footer Navigation -->
            <nav aria-label="Footer navigation">
                <ul class="flex flex-wrap gap-5 text-sm text-gray-600">
                    {footerLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="transition-colors hover:text-blue-600"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

        </div>

        <!-- Copyright -->
        <p class="mt-8 border-t border-gray-200 pt-5 text-sm text-gray-500">
            © {currentYear} Engineering Journal. All rights reserved.
        </p>

    </div>
</footer>
