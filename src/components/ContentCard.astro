---
interface Props {
    title: string;
    description: string;
    href: string;
    meta?: string;
    headingLevel?: "h2" | "h3";
}

const {
    title,
    description,
    href,
    meta,
    headingLevel = "h2"
} = Astro.props;
---

<article class="h-full rounded-xl border border-gray-200 p-4 transition-shadow hover:shadow-md sm:p-5">
    {headingLevel === "h2" ? (
        <h2 class="text-xl font-semibold">
            <a href={href} class="hover:text-blue-600">
                {title}
            </a>
        </h2>
    ) : (
        <h3 class="text-xl font-semibold">
            <a href={href} class="hover:text-blue-600">
                {title}
            </a>
        </h3>
    )}

    <p class="mt-2 text-gray-600">
        {description}
    </p>

    {meta && (
        <p class="mt-3 text-sm text-gray-500">
            {meta}
        </p>
    )}
</article>