
---
const navigation = [
    { label: "Home", href: "/" },
    { label: "Projects", href: "/projects" },
    { label: "Blogs", href: "/blogs" },
    { label: "Topics", href: "/topics" },
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" },
    { label: "Search", href: "/search" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-[#E5E9E5] bg-[#F5F3EA]">
    <nav
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 px-4 py-4 sm:flex-row sm:px-6"
        aria-label="Main navigation"
    >
        <!-- Brand Identity -->
        <a
            href="/"
            class="flex shrink-0 items-center gap-3"
            aria-label="Engineering Journal home"
        >
            <img
                src="/favicon.svg"
                alt=""
                width="44"
                height="44"
                class="h-11 w-11"
            />

            <span class="flex flex-col">
                <span class="font-serif text-xl font-semibold tracking-tight text-[#153D32]">
                    Engineering Journal
                </span>

                <span class="text-[9px] font-semibold uppercase tracking-[0.25em] text-[#526B5C]">
                    By ApexFury
                </span>
            </span>
        </a>

        <!-- Navigation Links -->
        <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
            {navigation.map((item) => {
                const isActive =
                    currentPath === item.href ||
                    (
                        item.href !== "/" &&
                        currentPath.startsWith(`${item.href}/`)
                    );

                return (
                    <li>
                        <a
    href={item.href}
    aria-current={isActive ? "page" : undefined}
    class:list={[
        "border-b-2 pb-1 text-sm font-medium transition-colors duration-200",
        isActive
            ? "border-[#153D32] text-[#153D32]"
            : "border-transparent text-gray-600 hover:border-[#8FA99A] hover:text-[#153D32]",
    ]}
>
    {item.label}
</a>
                    </li>
                );
            })}
        </ul>
    </nav>
</header>
